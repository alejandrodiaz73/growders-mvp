# ─────────────────────────────────────────────
# GROWDERS MVP — Backend Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_DEBUG=true               # false in production

# ── Database ─────────────────────────────────
# Local dev: leave DATABASE_URL empty → uses SQLite at ./data/growders.db
# Railway / Render: set the full PostgreSQL URL
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false                # true → prints all SQL (dev only)

# ── Cache ─────────────────────────────────────
# Tier 0: leave empty → in-memory cache (single process only)
# Tier 1: redis://user:pass@host:6379/0
REDIS_URL=
CACHE_TTL_SECONDS=300

# ── LLM Provider ─────────────────────────────
# Options: groq | openai | gemini | mock
LLM_PROVIDER=mock
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=                   # leave empty → uses provider default
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# ── WhatsApp ──────────────────────────────────
# Options: mock | 360dialog | vonage
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-for-webhook-verification

# ── Email (SMTP) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Growders

# ── Google Calendar ───────────────────────────
GOOGLE_CALENDAR_CREDENTIALS_JSON=   # path to service-account JSON file
GOOGLE_CALENDAR_ID=

# ── Security ──────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20

# ── Async / Workers ───────────────────────────
# Tier 0: leave empty → FastAPI BackgroundTasks
# Tier 1: celery
TASK_BACKEND=fastapi
CELERY_BROKER_URL=

# ── Observability ────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
SENTRY_DSN=                  # leave empty to disable
